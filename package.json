{
    "name": "Corpus",
    "version": "0.1.0",
    "description": "本地文档知识库问答：上传文档，带引用地提问",
    "main": "packages/shell/main.mjs",
    "author": "Corpus",
    "private": true,
    "scripts": {
        "test": "pnpm -r --if-present test",
        "dev": "node scripts/dev.mjs",
        "dev-el": "node scripts/dev.mjs --electron",
        "dev:server": "pnpm --filter @corpus/server dev",
        "dev:web": "pnpm --filter @corpus/web dev",
        "electron": "electron --no-sandbox packages/shell",
        "build": "node scripts/build-package.mjs --out dist-package/app && electron-builder --config electron-builder.yml",
        "build:app": "node scripts/build-package.mjs --out dist-package/app",
        "build:web": "pnpm --filter @corpus/web build",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:flow": "pnpm --filter @corpus/server test:flow"
    },
    "keywords": [],
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.18.0",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "electron": "^45.3.3",
        "electron-builder": "^26.18.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "oxlint": "^1.93.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.2"
    }
}
