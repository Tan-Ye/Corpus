# 复制成 .env 再填。.env 不进 git。
# 只在 NODE_ENV 不是 production 时读取（规则见 docs/architecture.md §11）

# ── LLM ────────────────────────────────────────────────
# 只支持 OpenAI 兼容接口（POST /chat/completions）
# baseURL 末尾不要带斜杠；/v1 这类版本前缀按 provider 文档写
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 换 provider 只改上面三行，例如：
#   OpenAI    https://api.openai.com/v1                        gpt-4o-mini
#   阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1 qwen-plus
#   月之暗面   https://api.moonshot.cn/v1                       moonshot-v1-8k
#   本地 Ollama http://127.0.0.1:11434/v1                       qwen2.5

# ── Server ─────────────────────────────────────────────
# 默认 8787。M5 起前端用 Vite（5173），别撞。
PORT=8787
