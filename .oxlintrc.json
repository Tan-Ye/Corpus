{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "no-console": "off",
        "no-underscore-dangle": ["warn", { "allow": ["__filename", "__dirname"] }],
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": "off",
        "oxc/no-async-endpoint-handlers": "off"
    },
    "env": {
        "es2024": true
    },
    "overrides": [
        {
            "files": ["packages/core/**", "packages/server/**"],
            "env": {
                "node": true
            }
        },
        {
            "files": ["packages/web/**"],
            "env": {
                "browser": true
            }
        }
    ],
    "ignorePatterns": [
        "**/dist/**",
        "**/dist-package/**",
        "**/data/**",
        "**/.tmp/**",
        "**/*.d.ts"
    ]
}
